int compare(const void *a, const void *b) {
    return (*(int*)a - *(int*)b);
}

int canPlace(int *position, int n, int m, long long minForce) {
    int count = 1;
    int lastPos = position[0];

    for (int i = 1; i < n; i++) {
        if ((long long)position[i] - lastPos >= minForce) {
            count++;
            lastPos = position[i];
            if (count == m) return 1;
        }
    }
    return 0;
}

int maxDistance(int* position, int positionSize, int m) {
    qsort(position, positionSize, sizeof(int), compare);

    long long lo = 1;
    long long hi = (long long)position[positionSize - 1] - position[0];
    long long result = 0;

    while (lo <= hi) {
        long long mid = lo + (hi - lo) / 2;

        if (canPlace(position, positionSize, m, mid)) {
            result = mid;
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }

    return (int)result;
}
