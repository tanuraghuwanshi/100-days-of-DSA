// Implement merge sort (divide, sort halves, merge).
  Print sorted array.

#include <stdio.h>
void merge(int arr[], int l, int m, int r) {
    int i, j, k;
    int n1 = m - l + 1;   /* size of left half  */
    int n2 = r - m;       /* size of right half */

    /* Temporary arrays */
    int L[n1], R[n2];

    /* Copy data into temp arrays */
    for (i = 0; i < n1; i++) L[i] = arr[l + i];
    for (j = 0; j < n2; j++) R[j] = arr[m + 1 + j];

    /* Merge the two halves back into arr[] */
    i = 0; j = 0; k = l;
    while (i < n1 && j < n2) {
        if (L[i] <= R[j])
            arr[k++] = L[i++];
        else
            arr[k++] = R[j++];
    }

    /* Copy remaining elements (if any) */
    while (i < n1) arr[k++] = L[i++];
    while (j < n2) arr[k++] = R[j++];
}

/* Divide array into halves, sort each, then merge */
void mergeSort(int arr[], int l, int r) {
    if (l < r) {
        int m = l + (r - l) / 2;   /* mid point (avoids overflow) */

        mergeSort(arr, l, m);       /* sort left  half */
        mergeSort(arr, m + 1, r);   /* sort right half */
        merge(arr, l, m, r);        /* merge sorted halves */
    }
}

void printArray(int arr[], int n) {
    for (int i = 0; i < n; i++)
        printf("%d ", arr[i]);
    printf("\n");
}

int main() {
    int arr[] = {38, 27, 43, 3, 9, 82, 10};
    int n = sizeof(arr) / sizeof(arr[0]);

    printf("Original array: ");
    printArray(arr, n);

    mergeSort(arr, 0, n - 1);

    printf("Sorted array:   ");
    printArray(arr, n);

    return 0;
}
