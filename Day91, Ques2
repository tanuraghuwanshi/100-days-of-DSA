void sortColors(int* nums, int numsSize) {
    int lo  = 0;
    int mid = 0;
    int hi  = numsSize - 1;

    while (mid <= hi) {
        if (nums[mid] == 0) {
            int tmp = nums[lo]; nums[lo] = nums[mid]; nums[mid] = tmp;
            lo++; mid++;
        } else if (nums[mid] == 1) {
            mid++;
        } else {
            int tmp = nums[hi]; nums[hi] = nums[mid]; nums[mid] = tmp;
            hi--;
        }
    }
}
