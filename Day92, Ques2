#include <stdlib.h>   /* rand(), srand() */
#include <time.h>     /* time()          */
void swap(int *a, int *b) { int t = *a; *a = *b; *b = t; }
    int pivotIdx = lo + rand() % (hi - lo + 1);
    swap(&nums[pivotIdx], &nums[hi]);

    int pivot = nums[hi];
    int i     = lo - 1;

    for (int j = lo; j < hi; j++) {
        if (nums[j] >= pivot) {   /* >= so larger values go LEFT */
            i++;
            swap(&nums[i], &nums[j]);
        }
    }
    swap(&nums[i + 1], &nums[hi]);
    return i + 1;
}

