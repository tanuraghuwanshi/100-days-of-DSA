int quickselect(int *nums, int lo, int hi, int k) {
    if (lo == hi) return nums[lo];

    int pi = partition(nums, lo, hi);

    if (pi == k - 1)       return nums[pi];   /* exact position  */
    else if (pi < k - 1)   return quickselect(nums, pi + 1, hi, k);
    else                   return quickselect(nums, lo, pi - 1, k);
}

int findKthLargest(int* nums, int numsSize, int k) {
    srand((unsigned)time(NULL));
    return quickselect(nums, 0, numsSize - 1, k);
}
