int canSplit(int* nums, int n, int k, long long mid) {
    int splits = 1;
    long long current = 0;

    for (int i = 0; i < n; i++) {
        if (nums[i] > mid) return 0;
        if (current + nums[i] > mid) {
            splits++;
            current = nums[i];
            if (splits > k) return 0;
        } else {
            current += nums[i];
        }
    }
    return 1;
}

int splitArray(int* nums, int numsSize, int k) {
    long long lo = 0, hi = 0;

    for (int i = 0; i < numsSize; i++) {
        if (nums[i] > lo) lo = nums[i];
        hi += nums[i];
    }

    long long ans = hi;

    while (lo <= hi) {
        long long mid = lo + (hi - lo) / 2;
        if (canSplit(nums, numsSize, k, mid)) {
            ans = mid;
            hi = mid - 1;
        } else {
            lo = mid + 1;
        }
    }

    return (int)ans;
}
