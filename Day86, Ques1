// Find the integer square root of a given non-negative integer using Binary Search. The integer square root of a number is defined as the greatest integer whose square is less than or equal to the given number.

#include <stdio.h>

int integerSqrt(int n) {
    if (n == 0 || n == 1)
        return n;

    int low = 0, high = n, mid;
    int ans = 0;

    while (low <= high) {
        mid = (low + high) / 2;

        if (mid * mid == n) {
            return mid;   // exact square root
        }
        else if (mid * mid < n) {
            ans = mid;    // store possible answer
            low = mid + 1;
        }
        else {
            high = mid - 1;
        }
    }

    return ans;  // integer square root
}

int main() {
    int n;
    printf("Enter a non-negative integer: ");
    scanf("%d", &n);

    printf("Integer square root = %d\n", integerSqrt(n));
    return 0;
}
